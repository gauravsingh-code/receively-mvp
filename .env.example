# ==============================================
# Receively MVP — Environment Configuration Template
# ==============================================
# Copy this file to .env (or server/.env and client/.env) before running.
# NEVER commit real credentials or secret keys to version control.

# ==============================================
# 1. BACKEND CONFIGURATION (server/)
# ==============================================
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/receively_dev?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=receively_dev
DB_USER=postgres
DB_PASSWORD=password

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Optional Services
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ==============================================
# 2. FRONTEND CONFIGURATION (client/)
# ==============================================
# Base URL for Express backend API:
VITE_API_URL=http://localhost:4000/api
